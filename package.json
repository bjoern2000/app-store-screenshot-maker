{
  "name": "app-store-screenshot-maker",
  "version": "0.1.0",
  "description": "Local MCP server for designing App Store / Play Store screenshots with HTML/CSS",
  "type": "module",
  "license": "MIT",
  "bin": {
    "app-store-screenshot-maker": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/ui/public','dist/ui/public',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chokidar": "^3.6.0",
    "fastify": "^4.28.1",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
